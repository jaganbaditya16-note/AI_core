# ─────────────────────────────────────────────────────────────────────────────
# AICore — environment variables
#
#   cp .env.example .env        # local development and Docker Compose
#   cp .env.example apps/web/.env.local   # only needed for frontend-only work
#
# .env is gitignored. Never commit real credentials: placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by the Compose `db` service and to assemble AICORE_DATABASE_URL.
POSTGRES_USER=aicore
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=aicore
POSTGRES_PORT=5432

# ── API (backend) ─────────────────────────────────────────────────────────────
# Read by the FastAPI app; the AICORE_ prefix maps to Settings fields.
AICORE_ENVIRONMENT=development            # development | test | staging | production
AICORE_DEBUG=false
AICORE_LOG_LEVEL=info                     # critical | error | warning | info | debug
AICORE_DOCS_ENABLED=true                  # set false in production
AICORE_API_HOST=0.0.0.0
AICORE_API_PORT=8000

# Required. Must be a PostgreSQL URL. Never exposed to the browser.
#   local (API on the host):  localhost:5432
#   docker compose:           db:5432   (Compose builds this URL for the api service)
AICORE_DATABASE_URL=postgresql+psycopg://aicore:change-me-local-dev-only@localhost:5432/aicore

# Connection pool (max_overflow is fixed at 0; connections beyond pool_size queue).
AICORE_DATABASE_POOL_SIZE=5
AICORE_DATABASE_CONNECT_TIMEOUT_SECONDS=5

# CORS — empty by default. The browser uses the Next.js same-origin proxy, so
# the API normally needs no cross-origin access at all. Wildcards are rejected
# in production.
AICORE_CORS_ALLOW_ORIGINS=
AICORE_CORS_ALLOW_CREDENTIALS=false

# ── Web (frontend) ────────────────────────────────────────────────────────────
# Server-only variable: where the web tier reaches the API.
#   local dev (API on the host): http://127.0.0.1:8000
#   docker compose:              http://api:8000
API_INTERNAL_URL=http://127.0.0.1:8000

# Falls back to API_INTERNAL_URL when unset. Anything NEXT_PUBLIC_* is inlined
# into the browser bundle — never put credentials there.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend request timeout in milliseconds (250–30000).
API_REQUEST_TIMEOUT_MS=4000
NEXT_PUBLIC_APP_VERSION=0.1.0

# Host port for the web container (Compose only).
WEB_PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# Development-agent tooling (NOT part of the AICore runtime)
# These are consumed by the local tooling described in TOOLKIT.md. The AICore
# application never reads them, and they are never copied into a runtime image.
# ─────────────────────────────────────────────────────────────────────────────

# 21st.dev component registry / MCP (optional; requires network egress)
API_KEY_21ST=
TWENTYFIRST_TOKEN=

# ruflo / claude-flow (optional; memory backend stays sqlite on low-RAM hosts)
CLAUDE_FLOW_MEMORY_BACKEND=sqlite
CLAUDE_FLOW_TOPOLOGY=hierarchical-mesh
CLAUDE_FLOW_MAX_AGENTS=15

# gstack (optional): set to 1 to skip the Chromium download during ./setup
# GSTACK_SKIP_PLAYWRIGHT=1
# GSTACK_SKIP_CSO_BUILD=1
# GSTACK_CHROMIUM_PATH=/usr/bin/chromium

# node-gyp headers for native modules when nodejs.org is unreachable
# npm_config_nodedir=/usr/local/include/node

# Playwright: use an existing Chromium when the browser CDN is unreachable
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
