# AI Core — environment variables
#
# Copy to .env (gitignored) or export these in your shell.
# Nothing here is required for the app to build; each entry unblocks a tool.

# ── 21st.dev ──────────────────────────────────────────────────────────────────
# Required for registry + MCP calls: search, generate, add, bookmarks, teams.
# Get a key at https://21st.dev/mcp  (or run: npx @21st-dev/cli@latest login)
# Both names are accepted by the CLI; API_KEY_21ST is what .mcp.json interpolates.
API_KEY_21ST=
TWENTYFIRST_TOKEN=

# ── ruflo / claude-flow ───────────────────────────────────────────────────────
# Already set for the MCP server inside .mcp.json. Override here only if needed.
# Memory backend: memory | sqlite | agentdb | hybrid.
#   sqlite   = file-backed, low-memory (recommended on hosts with <8GB RAM)
#   agentdb  = vector/HNSW — allocates ~4GB, aborts on small hosts
#   hybrid   = sqlite + agentdb
CLAUDE_FLOW_MEMORY_BACKEND=sqlite
CLAUDE_FLOW_TOPOLOGY=hierarchical-mesh
CLAUDE_FLOW_MAX_AGENTS=15
# Optional: relocate ruflo's memory database
# CLAUDE_FLOW_DB_PATH=/absolute/path/to/memory.db

# ── gstack ────────────────────────────────────────────────────────────────────
# Optional. Set to 1 to skip the Chromium download during ./setup (this sandbox
# sets it because no browser is available).
# GSTACK_SKIP_PLAYWRIGHT=1
# GSTACK_SKIP_CSO_BUILD=1
# Optional: use an already-installed Chromium instead of Playwright's copy.
# GSTACK_CHROMIUM_PATH=/usr/bin/chromium

# ── build (this sandbox only) ─────────────────────────────────────────────────
# node-gyp cannot reach nodejs.org here, but Node's C++ headers are installed
# locally. bootstrap.sh sets this automatically; exports needed if you run npm
# install by hand.
# npm_config_nodedir=/usr/local/include/node
