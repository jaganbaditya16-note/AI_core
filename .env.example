# ─────────────────────────────────────────────────────────────────────────────
# AICore — environment variables
#
#   cp .env.example .env        # local development and Docker Compose
#
# .env is gitignored. Never commit real credentials: placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=aicore
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=aicore
POSTGRES_PORT=5432

# ── API ───────────────────────────────────────────────────────────────────────
AICORE_ENVIRONMENT=development            # development | test | staging | production
AICORE_DEBUG=false
AICORE_LOG_LEVEL=info                     # critical | error | warning | info | debug
AICORE_DOCS_ENABLED=true                  # set false in production
AICORE_API_HOST=0.0.0.0
AICORE_API_PORT=8000
AICORE_DATABASE_URL=postgresql+psycopg://aicore:change-me-local-dev-only@localhost:5432/aicore
AICORE_DATABASE_POOL_SIZE=5
AICORE_DATABASE_CONNECT_TIMEOUT_SECONDS=5
AICORE_AUTH_PROVIDER=api_token
AICORE_CORS_ALLOW_ORIGINS=
AICORE_CORS_ALLOW_CREDENTIALS=false

# ── NVIDIA Nemotron via Nebius Token Factory ─────────────────────────────────
# Optional for local development; required for live AI investigation.
# Keep this server-side. Never use NEXT_PUBLIC_ for the key.
AICORE_NEBIUS_API_KEY=
AICORE_NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
AICORE_NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
AICORE_NEBIUS_TIMEOUT_SECONDS=30

# ── Web ───────────────────────────────────────────────────────────────────────
API_INTERNAL_URL=http://127.0.0.1:8000
API_REQUEST_TIMEOUT_MS=4000
NEXT_PUBLIC_APP_VERSION=0.1.0
WEB_PORT=3000

# ── Development-agent tooling (not part of the AICore runtime) ───────────────
API_KEY_21ST=
TWENTYFIRST_TOKEN=
CLAUDE_FLOW_MEMORY_BACKEND=sqlite
CLAUDE_FLOW_TOPOLOGY=hierarchical-mesh
CLAUDE_FLOW_MAX_AGENTS=15
