# ─────────────────────────────────────────────────────────────────────────────
# AICore — environment variables
#
#   cp .env.example .env        # local development and Docker Compose
#
# .env is gitignored. Never commit real credentials: placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=aicore
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=aicore
POSTGRES_PORT=5432

# ── API (backend) ─────────────────────────────────────────────────────────────
AICORE_ENVIRONMENT=development
AICORE_DEBUG=false
AICORE_LOG_LEVEL=info
AICORE_DOCS_ENABLED=true
AICORE_API_HOST=0.0.0.0
AICORE_API_PORT=8000
AICORE_DATABASE_URL=postgresql+psycopg://aicore:change-me-local-dev-only@localhost:5432/aicore
AICORE_DATABASE_POOL_SIZE=5
AICORE_DATABASE_CONNECT_TIMEOUT_SECONDS=5
AICORE_AUTH_PROVIDER=api_token

# CORS is empty by default. The browser uses the Next.js same-origin proxy.
AICORE_CORS_ALLOW_ORIGINS=
AICORE_CORS_ALLOW_CREDENTIALS=false

# ── Nebius Token Factory / NVIDIA Nemotron ───────────────────────────────────
# Optional. Never put this value in NEXT_PUBLIC_* variables or source control.
# The API validates the endpoint as HTTPS and allow-lists Nebius Token Factory hosts.
AICORE_NEBIUS_API_KEY=
AICORE_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
AICORE_NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
AICORE_NEBIUS_TIMEOUT_SECONDS=20
AICORE_NEBIUS_MAX_OUTPUT_TOKENS=900

# ── Web (frontend) ────────────────────────────────────────────────────────────
# Server-only variable: where the web tier reaches the API.
API_INTERNAL_URL=http://127.0.0.1:8000
API_REQUEST_TIMEOUT_MS=4000
NEXT_PUBLIC_APP_VERSION=0.1.0
WEB_PORT=3000

# ── Development-agent tooling (not part of AICore runtime) ──────────────────
API_KEY_21ST=
TWENTYFIRST_TOKEN=
CLAUDE_FLOW_MEMORY_BACKEND=sqlite
CLAUDE_FLOW_TOPOLOGY=hierarchical-mesh
CLAUDE_FLOW_MAX_AGENTS=15
# GSTACK_SKIP_PLAYWRIGHT=1
# GSTACK_SKIP_CSO_BUILD=1
# GSTACK_CHROMIUM_PATH=/usr/bin/chromium
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# AICORE_TEST_DATABASE_URL=postgresql+psycopg:///aicore?host=/path/to/.pgdata&user=aicore
